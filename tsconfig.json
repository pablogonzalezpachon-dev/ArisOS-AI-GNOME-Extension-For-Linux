{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
  },
  "include": [
    "ambient.d.ts",
    "components/**/*.ts",
    "utils/**/*.ts",
    "server/**/*.ts"
  ],
  "files": [
    "extension.ts",
  ],
  
}
